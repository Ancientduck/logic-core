# User Profile
USER_NAME="YourName"

# ==========================================
# LOGIC / VINCI — Environment Configuration
# ==========================================

# Core Gateway API Key & Endpoint (OmniRoute / OpenAI compatible)
API_KEY=your_omniroute_or_openai_key_here
BASE_URL=http://localhost:20128/v1

# Primary & Code Models
MODEL=agy/gemini-3.1-flash-lite
MODEL_CODE=gpt-4o-mini
MODEL_NAME_GROQ=openai/gpt-oss-120b

# Groq Cloud API Key (Fast reasoning & Whisper voice)
# Obtain at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# You.com Search Net API Key (Real-time web search)
# Obtain at https://api.you.com
YDC_API_KEY=your_you_com_key_here

# TinyFish Web Scraper API Key (Dynamic headless JS extraction)
# Obtain at https://tinyfish.io
TINYFISH_API_KEY=your_tinyfish_key_here
